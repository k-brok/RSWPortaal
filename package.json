{
  "name": "rsw-portaal",
  "version": "0.1.0",
  "description": "RSW Portaal — Regionale Scouting Wedstrijden, Regio De Langstraat",
  "author": "CHUNKK",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node src/app.js",
    "start": "NODE_ENV=production node src/app.js",
    "migrate": "node src/config/migrate.js",
    "seed": "node db/seeds/001_testdata.js",
    "migrate:seed": "npm run migrate && npm run seed",
    "version:patch": "./scripts/bump-version.sh patch",
    "version:minor": "./scripts/bump-version.sh minor",
    "version:major": "./scripts/bump-version.sh major",
    "feature": "./scripts/start-feature.sh",
    "release:start": "./scripts/start-release.sh",
    "release:finish": "./scripts/finish-release.sh",
    "hotfix": "./scripts/start-hotfix.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "pdfmake": "^0.3.7",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  }
}
